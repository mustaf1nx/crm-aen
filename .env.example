# Use long random strings; avoid @, :, / and # in DB_PASSWORD unless URL-encoded.
DB_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARS
CORS_ORIGINS=https://crm.example.com

# Instagram: leave blank until configured. NEVER share real values.
IG_VERIFY_TOKEN=
META_APP_SECRET=
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
IG_PAGE_ID=
IG_CITY_NAME=Семей
IG_AUTH_MODE=facebook
# For local demo only. Turn off before public access.
ENABLE_DEMO_INGEST=false
